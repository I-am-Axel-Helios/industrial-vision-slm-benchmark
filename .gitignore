# ============================================================
# Industrial Vision SLM Benchmark - Git Ignore
# ============================================================

# Environnements virtuels Python
.venv/
venv/
env/

# Fichiers temporaires Python
__pycache__/
*.py[cod]
.pytest_cache/

# Fichiers temporaires Jupyter
.ipynb_checkpoints/

# Secrets et variables d'environnement
.env
.env.*
!.env.example
*.key
*token*.txt

# Données locales et résultats volumineux
# Ignorer les données volumineuses
/data/*

# Conserver le dossier racine dans Git
!/data/.gitkeep

# Autoriser uniquement notre jeu d'évaluation public
!/data/evaluation/
/data/evaluation/*
!/data/evaluation/questions.jsonl
!/data/evaluation/freeze_manifest.json

# Résultats des expérimentations
/outputs/*
!/outputs/.gitkeep

# Poids de modèles et checkpoints
*.safetensors
*.ckpt
*.pth
*.pt

# Fichiers temporaires du système
.DS_Store
Thumbs.db

# Corpus documentaire local : fichiers sources et dérivés.
# Autoriser l'accès au dossier du corpus.
!/data/corpus/

# Ignorer son contenu par défaut.
/data/corpus/*

# Conserver les métadonnées de reproductibilité.
!/data/corpus/source_registry.json
!/data/corpus/chunk_manifest.json
!/data/corpus/retrieval_manifest.json
!/data/corpus/corpus_report.json

# Exclure explicitement les documents et chunks générés.
/data/corpus/raw/
/data/corpus/processed/
/data/corpus/chunks/